{
  "manifestVersion": 5,
  "id": "com.layerdoctor.photoshop",
  "name": "LayerDoctor",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "23.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "layerdoctor.panel",
      "label": {
        "default": "LayerDoctor"
      },
      "minimumSize": {
        "width": 300,
        "height": 320
      },
      "maximumSize": {
        "width": 800,
        "height": 2400
      },
      "preferredDockedSize": {
        "width": 330,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 680
      }
    }
  ]
}
